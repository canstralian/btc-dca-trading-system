# Configuration example for DCAlytics
# Copy this file to .env and adjust the values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Data Sources (optional)
BTC_DATA_SOURCE=coinapi  # Options: coinapi, cryptocompare, local
COINAPI_KEY=your_coinapi_key_here
CRYPTOCOMPARE_API_KEY=your_cryptocompare_key_here

# Simulation Settings
DEFAULT_START_DATE=2023-01-01
DEFAULT_END_DATE=2024-01-01
MAX_SIMULATION_DAYS=1095
DEFAULT_INVESTMENT_AMOUNT=100
DEFAULT_FREQUENCY_DAYS=7
DEFAULT_HEDGE_PERCENTAGE=10

# Risk Management
MAX_HEDGE_PERCENTAGE=50
MIN_INVESTMENT_AMOUNT=1
MAX_INVESTMENT_AMOUNT=10000

# Cache Settings
ENABLE_CACHE=true
CACHE_DURATION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/dcalytics.log